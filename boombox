leftSection:Button({
    Name = "Stop Music",
    Callback = function()
        pcall(function()
            local args1 = { "ToolMusicStop", "" }
            ReplicatedStorage:WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args1))
        end)
        
        pcall(function()
            local args2 = { "PickingHouseMusicStop", "", [4] = true }
            ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Player1sHous1e"):FireServer(unpack(args2))
        end)

        pcall(function()
            local args3 = { "PickingScooterMusicText", "", [4] = true }
            ReplicatedStorage:WaitForChild("RE"):WaitForChild("1NoMoto1rVehicle1s"):FireServer(unpack(args3))
        end)

        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local sound = tool:FindFirstChildWhichIsA("Sound", true)
                    if sound then sound:Stop() end
                end
            end
        end
        local oldSound = workspace:FindFirstChild("BypassLocalSound")
        if oldSound then oldSound:Destroy() end
        
        Window:Notify({ 
            Title = "Stopped", 
            Description = "หยุดเล่นเพลงทั้งหมดแล้ว", 
            Lifetime = 3 
        })
    end,
})

