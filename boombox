local currentSoundId = ""
local currentVolume = 9999

local function extractID(input)
    if not input then return nil end
    input = tostring(input)
    local id = string.match(input, "rbxassetid://(%d+)") or string.match(input, "%d+")
    return id
end

local function playServerSide(id, volume)
    local soundId = "rbxassetid://" .. id
    local char = LocalPlayer.Character
    
    pcall(function()
        local args = { "ToolMusicText", id, nil, [4] = true }
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
    end)
    
    pcall(function()
        local args = { "PickingScooterMusicText", id, [4] = true }
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("1NoMoto1rVehicle1s"):FireServer(unpack(args))
    end)
    
    pcall(function()
        local args = { math.clamp(volume / 100, 0, 100) }
        LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainGUIHandler"):WaitForChild("MainAudio"):WaitForChild("Catalog"):WaitForChild("Header"):WaitForChild("VolumeContainer"):WaitForChild("VolumeChangeRequest"):FireServer(unpack(args))
    end)
    
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and (string.find(tool.Name, "Boombox") or string.find(tool.Name, "Radio") or string.find(tool.Name, "Phone")) then
                local sound = tool:FindFirstChildWhichIsA("Sound", true)
                if sound then
                    sound.SoundId = soundId
                    sound.Volume = volume
                    sound.TimePosition = 0
                    sound:Play()
                end
                break
            end
        end
    end
    
    Window:Notify({
        Title = "เปิดเพลง สำเร็จ!", 
        Description = "ส่งคำสั่งเพลงไปยังอุปกรณ์ทั้งหมดแล้ว", 
        Lifetime = 4
    })
end

